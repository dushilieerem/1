# Python 缓存和构建产物
__pycache__/
*.py[cod]
*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg

# 本机配置与敏感凭据
backend/.env
**/.env
!**/.env.example
*.pem
*.key

# 后端运行产物和可再生缓存
backend/output/
backend/data/
*.db
*.sqlite
*.sqlite-journal
*.log
logs/

# KnowledgeHub 上传附件（已入库的示例文件仍由 Git 跟踪）
KnowledgeHub/data/kh_attachments/*

# 外部行情目录若被误放回仓库，不纳入 Git
marketdata/
MarketData/
!MarketData/README.md

# 前端依赖和构建产物
node_modules/
frontend/.vite/
frontend/dist/
KnowledgeHub/frontend/node_modules/
KnowledgeHub/frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm-cache/
*.tsbuildinfo

# 本机临时文件、编辑器和系统文件
.idea/
.vscode/
AGENTS.md
CLAUDE.md
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
tmp/
_tmp_*
_notes/
.claude/
.codex/

# 前端/端到端测试运行产物（每次运行都会变）
test-results/

# CI 本地运行产物（venv、临时 env 备份、部署回滚点、WebHook 任务日志）
.ci/
**/.env.ci-backup
deploy/.last-good.env
deploy/runtime/
deploy/backups/
deploy/webhook-logs/
