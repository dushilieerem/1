# 复制本文件为 .env 后按「你自己电脑」修改（.env 勿提交 git）
#
# DATABASE_URL 里的 127.0.0.1 = 跑 API 的这台机器上的 Postgres，
# 不是去连别人电脑。密码必须与你本机 CREATE USER 时一致。

DATABASE_URL=postgresql://svquant:YOUR_PASSWORD@127.0.0.1:5432/svquant
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
# 1 = 开发跳过鉴权（/api/auth/me 返回假用户）；协作演示请保持 0
DEV_SKIP_AUTH=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
