# 复制本文件为 .env 后按「你自己电脑」修改（.env 勿提交 git）
#
# DATABASE_URL 里的 127.0.0.1 = 跑 API 的这台机器上的 Postgres，
# 不是去连别人电脑。密码必须与你本机 CREATE USER 时一致。
# 库名默认用 svquant_dev，首次运行 ./scripts/init-dev-db.sh 创建开发库；
# 生产的库名是 svquant，只写在部署机的 deploy/.env 里。

DATABASE_URL=postgresql://svquant:YOUR_PASSWORD@127.0.0.1:5432/svquant_dev
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7
# 敏感配置加密主密钥（base64 32 字节；生产必须单独配置并轮换）
SECRET_ENCRYPTION_KEY=

# 独立 ResearchEngine（因子/回测/行情）；按实际部署地址修改
YG_RE_BASE=http://researchengine-host:9527
# RE 服务间 Token；必须与 RE config.yaml 的 server.service_token 一致
RE_SERVICE_TOKEN=
# 1 = 开发跳过鉴权（/api/auth/me 返回假用户）；协作演示请保持 0
DEV_SKIP_AUTH=0

# 允许跨域访问 API 的前端来源（逗号分隔）；留空 = 仅允许本机 9530 前端。
# 前端经 Vite 代理访问 /api 时为同源请求，不受此项影响；生产填正式域名，如 https://svquant.example.com
CORS_ORIGINS=

# /api/metrics：留空仅本机可读；生产设置 token 后采集端用 X-Metrics-Token 或 Bearer
METRICS_TOKEN=

# 登录/注册限流（同一 IP 每分钟次数，仅单 worker 部署时精确）
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REGISTER_RATE_LIMIT=10
AUTH_FORGOT_RATE_LIMIT=5
# 登录失败锁定：连续失败 N 次锁定 M 分钟
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
# 全站非 GET API 每用户/IP 每分钟上限
WRITE_RATE_LIMIT=120
# 多实例部署时改为 postgres，使用共享计数（默认 memory = 进程内）
RATE_LIMIT_BACKEND=memory
# 社区敏感词（逗号分隔；命中拒绝发布）
COMMUNITY_BANNED_WORDS=
# 通知保留天数（启动清理）
NOTIFICATION_RETENTION_DAYS=90
# 1 = 找回密码接口直接返回 token（仅本地联调；生产必须 0）
AUTH_RESET_DEBUG=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# —— SVQuant Agent / LLM（OpenAI 兼容：DeepSeek、通义、OpenAI 等）——
# 未配置 LLM_API_KEY 时，发帖润色走本地 mock，便于无密钥联调。
# 社区摘要未配置 LLM_API_KEY 时，会通过 YG_RE_BASE 调用 RE /api/ai/post-summaries，
# 复用 RE 已能使用的因子生成模型配置，不需要在这里复制模型密钥。
# 仅无独立 LLM 且无 RE 的纯本地环境，摘要保留“原文节选（非 AI）”。
# 任意 OpenAI 兼容网关：官方、DeepSeek、内网 LiteLLM 等。
# 内网地址示例（按实际网关修改）；不要提交真实 Key。
LLM_BASE_URL=http://192.168.10.11:4000/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash-yxd
LLM_TIMEOUT_SEC=150
# 主模型超时/上游故障时的兜底模型（逗号分隔，模型 id 需在 ai/gateway/providers.py 目录中）
LLM_FALLBACK_MODELS=
# 同一模型超时/上游故障的重试次数（默认 1；参数错误与输出不合规不重试）
LLM_MAX_RETRIES=1
# 推理模型输出被 max_tokens 截断时，自动翻倍重试的上限（默认 32000）
LLM_MAX_OUTPUT_TOKENS=32000
# 非流式结果进程内缓存秒数（0 = 关闭）
LLM_CACHE_TTL_SEC=0
# 全站每日 token 预算（0 = 不限；超出后 AI 调用返回 429）
AI_DAILY_TOKEN_BUDGET=0

# 火山方舟（AI 因子生成 · Agent Plan）
AI_FACTOR_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AI_FACTOR_API_KEY=
ARK_API_KEY=
AI_FACTOR_MODEL_ALIAS=ark-code-latest

# 硅基流动 SiliconFlow（OpenAI 兼容 · SV 助手）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# —— 模拟盘（日终 VWAP 结算；后端进程内定时器）——
# 0 = 关闭自动结算与手动结算接口；已结算数据保留可审计
SVQUANT_PAPER_TRADING_ENABLED=1
# 数据就绪轮询间隔（秒）
SVQUANT_PAPER_POLL_SEC=300
# 单个账户一次最多补结算的交易日数
SVQUANT_PAPER_MAX_CATCHUP_DAYS=10
# 单次 RE 结算超时（秒）
SVQUANT_PAPER_SETTLE_TIMEOUT_SEC=300
# 可重试错误退避基数（秒）
SVQUANT_PAPER_RETRY_BACKOFF_SEC=300

# —— 面板日更 ——
# 1 = 增量刷新：已有成功指标的因子跳过，只补缺失/失败
SVQUANT_PANEL_INCREMENTAL=0

# —— AI 会话历史 ——
# 服务端会话保留天数（0 = 不清理）
AI_CONVERSATION_RETENTION_DAYS=90
# 1 = 允许社区策略帖调用 AI 点评（可随时置 0 关闭）
COMMUNITY_AI_REVIEW_ENABLED=1

# —— 因子目录定时同步（primary/all 双 scope；后端进程内定时器）——
# 0 = 关闭；启动时另有一次后台预热，本项只管后续定时轮次
RE_CATALOG_SYNC_ENABLED=1
# 同步间隔秒（默认每天）；<=0 关闭
RE_CATALOG_SYNC_INTERVAL_SEC=86400

# —— 资讯定时拉取（用户页不展示按钮；API 启动后后台线程）——
# 间隔秒；0 = 关闭定时。单次每源条数默认 12
NEWS_INGEST_INTERVAL_SEC=900
NEWS_INGEST_LIMIT=12
# 每源失败重试次数与线性退避基数（秒）
NEWS_FETCH_RETRIES=2
NEWS_FETCH_BACKOFF_SEC=2

# —— 独立数据平台（svquant-data，只读视图）——
# 数据平台负责采集/落盘/发布；业务只读 view，不再自己写采集逻辑
SVQUANT_DATA_ROOT=/home/dev01/project/svquant-data
SVQUANT_DATA_VIEW=current

# —— 本地行情数据（marketdata release；数据平台 iFinD 引用）——
# 与 ResearchEngine 共享的 release 目录；留空默认仓库同级 ../marketdata
MARKETDATA_DIR=

# —— KnowledgeHub 检索 ——
# 远程 rerank（OpenAI 兼容 /rerank）；留空用中文 bigram 关键词重排
KH_RERANK_URL=
KH_RERANK_API_KEY=
KH_RERANK_MODEL=bge-reranker-v2-m3
# pgvector 可用时的向量维度（0 = 不建 ANN 索引，仍可精确检索）
KH_VECTOR_DIM=0

# —— 机构端（/api/inst/*）——
# 1 = 启动时幂等写入演示机构「旸谷资本」与六个角色账号；生产/试点设为 0
INST_SEED_DEMO=1
# 六个演示账号的初始密码；生产必须替换或关闭种子
INST_DEMO_PASSWORD=inst123456
# 是否显示「模拟环境」标识；接入真实数据后设 0
INST_DEMO_MODE=1
# 机构端登录每分钟/IP 次数上限
INST_LOGIN_RATE_LIMIT=10
