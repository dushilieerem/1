# 复制为 deploy/.env 后填写；.env 已被 .gitignore 忽略，禁止提交真实值。
# 该文件同时用于 compose 变量替换和 backend 容器的 env_file。

# —— PostgreSQL（容器内网）——
POSTGRES_USER=svquant
POSTGRES_PASSWORD=
POSTGRES_DB=svquant
# 后端连接池总硬上限 = SIZE + OVERFLOW；池满等待 WAIT_SEC 后返回 503，避免打满 PG max_connections。
SVQUANT_DB_POOL_SIZE=20
SVQUANT_DB_POOL_OVERFLOW=5
SVQUANT_DB_POOL_WAIT_SEC=10

# —— 后端必填 ——
# 必须是长随机串；生成：openssl rand -base64 48
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7
# ResearchEngine 地址，例如 http://10.0.0.12:9527
YG_RE_BASE=
# 生产必须为 0
DEV_SKIP_AUTH=0
# 对外域名（逗号分隔、同源反代时可留空）
CORS_ORIGINS=

# /api/metrics：留空仅本机可读；生产设置 token 后采集端用 X-Metrics-Token 或 Bearer
METRICS_TOKEN=

# —— 可选：AI / 资讯供应商 ——
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=60
AI_FACTOR_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
AI_FACTOR_API_KEY=
ARK_API_KEY=
AI_FACTOR_MODEL_ALIAS=ark-code-latest
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# —— 模拟盘 ——
SVQUANT_PAPER_TRADING_ENABLED=1
SVQUANT_PAPER_POLL_SEC=300
SVQUANT_PAPER_MAX_CATCHUP_DAYS=10
SVQUANT_PAPER_SETTLE_TIMEOUT_SEC=300
SVQUANT_PAPER_RETRY_BACKOFF_SEC=300

# —— 机构端 ——
# 生产/试点应设 0，并手工建机构成员；开发可保留演示种子
INST_SEED_DEMO=0
# 仅在 INST_SEED_DEMO=1 时生效，必须替换
INST_DEMO_PASSWORD=
# 接入真实数据后设 0
INST_DEMO_MODE=1
INST_LOGIN_RATE_LIMIT=10

# —— 资讯定时拉取 ——
NEWS_INGEST_INTERVAL_SEC=900
NEWS_INGEST_LIMIT=12

# —— 编排本身 ——
# 宿主机 marketdata release 目录（只读挂载到容器 /marketdata）
# 不配置时默认 /home/dev01/project/marketdata
MARKETDATA_HOST_DIR=/home/dev01/project/marketdata
# 独立数据平台根目录（只读挂载到 /data/svquant-data）
SVQUANT_DATA_HOST_DIR=/home/dev01/project/svquant-data
SVQUANT_DATA_VIEW=current
# 前端对外端口（监听所有网卡）
WEB_PORT=9530
# 后端对外端口（监听所有网卡；容器内仍是 8766）
BACKEND_PORT=8766
# 数据库对外端口（监听所有网卡；原 dev02 实例已停用，生产库接管 5432）
DB_PORT=5432
# 可选：发布前备份的异地 rsync 目标，如 user@backup-host:/data/svquant-backups
# 不配置则只保留本机 deploy/backups；配置后复制失败会终止发布
BACKUP_REMOTE=

# 由 scripts/ci/deploy.sh 写入，用于回滚到上一组镜像；手工部署可留空
BACKEND_IMAGE=svquant-backend:local
WEB_IMAGE=svquant-web:local

# —— 手机 H5 与临时外网通道（deploy.sh 发布成功后自动启动）——
INVEST_API_PORT=8767
INVEST_H5_PORT=9540
# invest-api 的解释器；留空则用 PATH 里的 python3
INVEST_PYTHON=
# 留空时 serve-public.sh 会自动生成并写回本文件
INVEST_JWT_SECRET=
# cloudflared 路径；留空则用 $HOME/.local/bin/cloudflared
CLOUDFLARED_BIN=
# 1=发布后创建/复用临时通道，0=只启动服务不建通道
PUBLIC_TUNNELS=1
