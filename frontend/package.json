  "type": "module",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 tests/aiFactorFeedback.test.tsx tests/aiStrategyFeedback.test.tsx tests/backtestFilters.test.tsx tests/commentThreads.test.mjs tests/communityForms.test.tsx tests/communityLimits.test.mjs tests/factorIcMetrics.test.ts tests/factorPanelSort.test.ts tests/factorRegressions.test.tsx tests/factorFlowNavigation.test.tsx tests/newsFilters.test.tsx tests/paperTrading.test.ts tests/strategyFlowNavigation.test.tsx tests/strategyFactorSync.test.ts tests/strategyCodeFirstControls.test.tsx tests/instNav.test.ts tests/autosave.test.ts tests/i18n.test.ts tests/commentProgressive.test.tsx",
    "test:inst": "node --import tsx --test tests/instNav.test.ts tests/instV3Nav.test.ts tests/instDedupe.test.ts",
    "test:ai-factor": "node --import tsx --test tests/aiFactorFeedback.test.tsx",
    "test:ai-strategy": "node --import tsx --test tests/aiStrategyFeedback.test.tsx",
    "test:community": "node --import tsx --test tests/commentThreads.test.mjs tests/communityLimits.test.mjs tests/communityForms.test.tsx",
    "test:backtest-filters": "node --import tsx --test tests/backtestFilters.test.tsx",
    "test:comments": "node --test tests/commentThreads.test.mjs",
    "test:paper": "node --import tsx --test tests/paperTrading.test.ts",
    "dev": "vite --host --port 9530 --strictPort",
    "dev:http": "vite --host --port 9530 --strictPort",
    "dev:https": "set VITE_DEV_HTTPS=1&& set VITE_DEV_PORT=9530&& vite --host --port 9530 --strictPort",
    "build": "tsc && vite build",
    "build:dist": "vite build",
    "preview": "vite preview --host",
    "preview:stable": "vite preview --host --port 9532 --strictPort"
  },
