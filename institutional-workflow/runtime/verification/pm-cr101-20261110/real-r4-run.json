 low_prev.rolling(5, min_periods=5).min()\n-    r20 = high_prev.rolling(20, min_periods=20).max() - low_prev.rolling(20, min_periods=20).min()\n-    c = (1 - r5 / (r20 + eps)).clip(0, 1)\n-    mean_volume = volume_prev.rolling(20, min_periods=20).mean()\n-    v = self.volume / mean_volume.where(mean_volume != 0) - 1\n-    v = v.clip(-1, 2)\n-    v_pos = v.mask(v < 0, 0)\n-    raw = c * b * (1 + v_pos)\n-    return raw.rank(axis=1, pct=True)+    close_prev_valid = close_prev.where(close_prev > 0)\n+    r = self.close / close_prev_valid - 1.0\n+    d_raw = (self.high - self.low) / close_prev_valid\n+    d = d_raw.where(d_raw > 0)\n+    z = r / (d + 1e-12)\n+    signal = -z\n+    return signal.rank(axis=1, pct=True)", "gate_changes": [{"name": "方向Rank IC", "actual": -0.01533941870623579, "change": -0.012621263669606284, "parent_actual": -0.0027181550366295075}, {"name": "最大回撤", "actual": 0.06931138421189467, "change": 0.029418030047117134, "parent_actual": 0.03989335416477754}, {"name": "有效IC观测数", "actual": 63, "change": 19, "parent_actual": 44}, {"name": "方向 NW t", "actual": -0.4900470682063753, "change": -0.3854027778782624, "parent_actual": -0.1046442903281129}], "source_changed": true, "parent_report_id": "qf_8804b208-512d-4727-bf15-90b15048f3a3_development", "parent_candidate_id": "8804b208-512d-4727-bf15-90b15048f3a3", "source_diff_truncated": false, "same_execution_conditions": true}, "historical_k_source": "saved_gate", "historical_threshold": 2.2414027276049464, "next_new_trial_threshold": 2.3939797998185104}, "usage": {"model": "deepseek-flash-yxd", "tokens_in": 1927, "tokens_out": 1395, "finish_reason": "stop", "budget_call_id": "8edf94ee-d846-48fa-ac7f-d7c0e80b0a0f"}, "facts_hash": "954364dd6eb8ccd43b2736a3d0a3d0a7ef80095b5d4eb81a7aaed801887b2e1a", "interpretation": {"findings": ["研发门槛未通过：方向Rank IC=-0.01534 < 0.005，方向NW t=-0.490 < 历史阈值2.2414。", "最大回撤0.0693 <= 0.5、有效IC观测63 >= 60，但两项通过不足以弥补方向性失败。", "Rank IC序列覆盖2025-07-02至2025-09-26共63个有效观测；前半段均值-0.03746，后半段+0.00609，符号不稳定。", "相对父候选，方向Rank IC变化-0.01262、NW t变化-0.3854、最大回撤增加0.02942；在相同执行条件下表现更弱。", "源码由父候选的多项价格/成交量组合改为日内收益/振幅的负向标准化，属实质性改动；novelty_status=deferred。", "仅研发诊断，不含封存数值；不能据此批准或推断封存收益。"], "explanation": "该候选在第2次研发试验中未通过方向性门槛：Rank IC为负且NW t远低于固定阈值，说明当前信号方向与目标预测关系不一致。样本量满足最低要求，回撤约束也通过，但序列前后半段均值由明显负值转为接近零的正值，方向不稳定；与父候选相比，IC和t统计进一步恶化，回撤同时上升。源码改动显著， novelty 仍为 deferred。基于现有研发证据，较合理的动作是修订信号方向或假设并重新形成新试验，而不是请求封存或视为通过；该解释不构成批准。", "next_action": "revise", "uncertainty": ["novelty_status为deferred，创新性及多重尝试校正情况未知。", "仅约3个月、63个有效观测，样本期与市场状态代表性未知。", "父候选与候选的指标变化为描述性研发差异，不能替代额外市场检验。", "未提供交易成本、换手、容量与参数稳健性信息。", "方向为负可能提示信号符号需调整，但无法由本证据确认翻转后有效。", "封存结果未读取，最终封存表现未知。"], "evidence_refs": ["qf_216e30df-21dd-4562-8383-02c414a126da_development", "facts:954364dd6eb8ccd43b2736a3d0a3d0a7ef80095b5d4eb81a7aaed801887b2e1a"]}, "method_version": "bounded-factor-rd-v2"}, "hypothesis": "在锁定股票池、锁定视图与预登记研发区间内构造日频截面信号。对股票 i 在交易日 t 收盘后：r_i,t = close_{i,t}/close_{i,t-1} - 1（若 close_{i,t-1} 缺失或 <=0 则缺失）；d_i,t = (high_{i,t} - low_{i,t})/close_{i,t-1}（若 d_i,t <= 0 则缺失）；z_i,t = r_i,t/(d_i,t + 1e-12)；S_i,t = -z_i,t。对 S 在当日横截面内做百分位 rank（pct=True，同值取平均秩，缺失不参与），得 s_i,t；预测 s_i,t 越高，t+1 收盘至 t+2 收盘的收益越高。仅使用 t 日及之前的数据，只用 1 个交易日的回看（close_{i,t-1}），任意更长窗口都不再要求，因此每个可交易日的截面信号均可得。", "candidate_id": "216e30df-21dd-4562-8383-02c414a126da", "candidate_status": "development_failed"}, "decision": {"title": "修订：1日振幅归一化反转替代20日区间复合", "action": "revise", "binding": {"run_id": "1aea8ba2-7dfa-49fc-80eb-bd45d04cbf23", "current_k": 1, "contract_hash": "5ab825029031accd0996bfad0edd87a208db0f4425cd9cdff72682f8440f5bd2", "control_epoch": "0ce2c9ee-1a7b-4d75-9e8d-683fb60d8c37", "method_version": "bounded-factor-rd-v2", "parent_trial_no": 1, "next_new_trial_k": 2, "parent_branch_id": "2e476336-0d71-405b-9f1d-58978680002d", "parent_report_id": "qf_8804b208-512d-4727-bf15-90b15048f3a3_development", "parent_source_hash": "e9f00c2985f0ff5fabb7b125cef094c77bcaed5bdf68a22529282b752a265d44", "parent_candidate_id": "8804b208-512d-4727-bf15-90b1504